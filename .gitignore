# ---- 素材：554 MB，走单独同步，不进 git ----
# 首次部署用 scripts/sync-assets.ps1 拷过去；之后按需增量同步。
# 注意 frontend/assets/content/ 是后台上传的运行时数据，本来就不该进版本库。
frontend/assets/
!frontend/assets/
frontend/assets/*
!frontend/assets/engineering/
frontend/assets/engineering/*
!frontend/assets/engineering/tracked-excavator.glb
!frontend/assets/engineering/high-reach-demolition-excavator.glb
!frontend/assets/engineering/ik-excavator.glb
!frontend/assets/engineering/ATTRIBUTION.txt

